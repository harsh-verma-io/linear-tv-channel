# --- Media: never commit video. GitHub limitations. ---
*.mp4
*.mkv
*.mov
*.ts
*.m4s
*.m3u8
media/programs/*
media/idents/*
media/ads/*
!media/**/README.md
!media/**/.gitkeep

# --- Live stream output: regenerated constantly ---
stream/*
!stream/.gitkeep

# --- Logs and scratch ---
*.log
logs/

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- macOS ---
.DS_Store
